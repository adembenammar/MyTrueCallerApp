<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Boutons : coins 16dp, texte gras sans majuscules -->
    <style name="Widget.App.Button.Base" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">18dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Bouton principal : dégradé violet vers rose -->
    <style name="Widget.App.Button" parent="Widget.App.Button.Base">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/on_brand_primary</item>
        <item name="iconTint">@color/on_brand_primary</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/button_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.App.Button.Base">
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/danger_bg</item>
        <item name="android:textColor">@color/danger_fg</item>
        <item name="iconTint">@color/danger_fg</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Bouton d'action de la feuille contact : icône au-dessus du texte -->
    <style name="Widget.App.Button.Action" parent="Widget.App.Button.Base">
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">20dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Champs de saisie : fond doux, coins 16dp, contour bleu au focus -->
    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/field_bg</item>
        <item name="boxStrokeColor">@color/field_stroke_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="startIconTint">@color/ink_muted</item>
        <item name="endIconTint">@color/ink_muted</item>
    </style>

    <style name="Widget.App.TextField.Search">
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.App.EditText" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Textes -->
    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Feuille du bas (modification d'un contact) -->
    <style name="ThemeOverlay.App.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Sheet</item>
    </style>

    <style name="ShapeAppearance.App.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
