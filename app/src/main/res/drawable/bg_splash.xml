<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_deep" />
        </shape>
    </item>
    <!-- halo émeraude derrière le logo -->
    <item
        android:width="460dp"
        android:height="460dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:endColor="@color/glow_end"
                android:gradientRadius="50%"
                android:startColor="@color/glow_start"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="top|end"
        android:right="-120dp"
        android:top="-140dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/header_ring" />
        </shape>
    </item>
    <item
        android:width="300dp"
        android:height="300dp"
        android:bottom="-140dp"
        android:gravity="bottom|start"
        android:left="-120dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/header_ring" />
        </shape>
    </item>
</layer-list>
