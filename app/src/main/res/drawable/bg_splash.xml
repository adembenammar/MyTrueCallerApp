<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_navy" />
        </shape>
    </item>
    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="top|end"
        android:right="-120dp"
        android:top="-140dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/header_ring" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="top|end"
        android:right="-60dp"
        android:top="-80dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/header_ring" />
        </shape>
    </item>
    <!-- halo bleu en bas à gauche -->
    <item
        android:width="380dp"
        android:height="380dp"
        android:bottom="-180dp"
        android:gravity="bottom|start"
        android:left="-140dp">
        <shape android:shape="oval">
            <solid android:color="#2E2563EB" />
        </shape>
    </item>
</layer-list>
