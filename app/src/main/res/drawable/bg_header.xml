<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- bandeau graphite, arrondi en bas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/header_bg" />
            <corners
                android:bottomLeftRadius="36dp"
                android:bottomRightRadius="36dp" />
        </shape>
    </item>
    <!-- halo émeraude en haut à droite -->
    <item
        android:width="320dp"
        android:height="320dp"
        android:gravity="top|end"
        android:right="-120dp"
        android:top="-150dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="@color/glow_end"
                android:gradientRadius="50%"
                android:startColor="@color/glow_start"
                android:type="radial" />
        </shape>
    </item>
    <!-- anneau fin -->
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="top|end"
        android:right="-50dp"
        android:top="-70dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/header_ring" />
        </shape>
    </item>
</layer-list>
