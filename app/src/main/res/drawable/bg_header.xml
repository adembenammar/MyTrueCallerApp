<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- bandeau bleu nuit, arrondi en bas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_navy" />
            <corners
                android:bottomLeftRadius="36dp"
                android:bottomRightRadius="36dp" />
        </shape>
    </item>
    <!-- anneaux décoratifs en haut à droite -->
    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="top|end"
        android:right="-90dp"
        android:top="-100dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/header_ring" />
        </shape>
    </item>
    <item
        android:width="170dp"
        android:height="170dp"
        android:gravity="top|end"
        android:right="-45dp"
        android:top="-55dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/header_ring" />
        </shape>
    </item>
</layer-list>
