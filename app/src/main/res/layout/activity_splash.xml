<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="64dp"
    tools:context=".SplashActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- logo : carré arrondi bleu + pastille ambre -->
    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:clipChildren="false">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_logo"
            android:elevation="12dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_phone"
                app:tint="@color/white" />
        </FrameLayout>

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge_amber"
            android:elevation="13dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyTrue"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textColor="@color/white"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caller"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textColor="@color/brand_amber"
            android:textSize="34sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vos contacts, toujours à portée"
        android:textColor="@color/header_text_muted"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/brand_amber"
        app:trackColor="@color/progress_track"
        app:trackCornerRadius="4dp"
        app:trackThickness="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.12"
        android:text="CHARGEMENT"
        android:textColor="@color/header_text_muted"
        android:textSize="12sp" />

</LinearLayout>
