<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    tools:context=".Affiche">

    <!-- barre du haut : retour + titre + nombre de contacts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btn_retour_affiche"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="Retour"
            android:elevation="1dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_titre_affiche"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mes contacts"
                android:textAppearance="@style/TextAppearance.App.Display"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_count_affiche"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 contact"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.App.TextField.Search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:hint="Rechercher (nom, prénom, numéro)"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_recherche"
            style="@style/Widget.App.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_affiche"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="112dp" />

        <LinearLayout
            android:id="@+id/ll_vide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/avatar_blue_bg">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_group"
                    app:tint="@color/avatar_blue_fg" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_vide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Aucun contact\nAppuyez sur + pour en ajouter"
                android:textColor="@color/ink_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_ajout"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="28dp"
            android:contentDescription="Ajouter un contact"
            android:text="Nouveau"
            android:textAllCaps="false"
            android:textColor="@color/on_brand_amber"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_amber"
            app:icon="@drawable/ic_add_24"
            app:iconTint="@color/on_brand_amber"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent" />
    </FrameLayout>

</LinearLayout>
